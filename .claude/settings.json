{
  "permissions": {
    "allow": [
      "Bash(python3 .claude/scripts/gates/*)",
      "Bash(python3 .claude/scripts/wiki/*)",
      "Bash(python3 .claude/scripts/tools/*)",
      "Bash(python3 .claude/scripts/local_intel/*)",
      "Bash(python3 .claude/scripts/harness/*)",
      "Bash(.claude/scripts/harness/*)",
      "Bash(mvn *)",
      "Bash(gradle *)",
      "Bash(javac *)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Edit(.claude/wiki/**)",
      "Write(.claude/wiki/**)"
    ],
    "deny": []
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/scripts/harness/pre_tool_use_hook.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/scripts/harness/post_tool_use_hook.py"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/scripts/harness/post_read_hook.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/scripts/harness/user_prompt_submit_hook.py"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/scripts/harness/subagent_stop_hook.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/scripts/harness/stop_hook.py"
          }
        ]
      }
    ]
  }
}
