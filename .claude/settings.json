{
  "permissions": {
    "allow": [
      "Bash(python3 .claude/scripts/gates/*)",
      "Bash(python3 .claude/scripts/wiki/*)",
      "Bash(python3 .claude/scripts/tools/*)",
      "Bash(python3 .claude/scripts/local_intel/*)",
      "Bash(python3 .claude/scripts/harness/*)",
      "Bash(.claude/scripts/harness/*)",
      "Bash(mvn *)",
      "Bash(gradle *)",
      "Bash(javac *)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ],
    "deny": []
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/scripts/harness/post_tool_use_hook.sh"
          }
        ]
      }
    ]
  }
}
